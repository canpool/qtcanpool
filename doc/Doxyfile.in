# ---------------------------------------------------------------------------
# Doxyfile for the QtCanpool documentation site.
#
# This file is a template. doc/CMakeLists.txt substitutes every @...@
# placeholder and writes the result to the build tree; edit this template, never
# the generated Doxyfile.
#
# Only long-standing settings are listed here on purpose. Defaults change
# between Doxygen releases and the site is built both locally and on CI images
# whose Doxygen version differs, so an option is only written down when the
# value actually matters.
# ---------------------------------------------------------------------------

DOXYFILE_ENCODING      = UTF-8

PROJECT_NAME           = "@DOXYGEN_PROJECT_NAME@"
PROJECT_NUMBER         = "@DOXYGEN_PROJECT_NUMBER@"
PROJECT_BRIEF          = "@DOXYGEN_PROJECT_BRIEF@"
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIR@"

OUTPUT_LANGUAGE        = @DOXYGEN_OUTPUT_LANGUAGE@
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@DOXYGEN_STRIP_FROM_PATH@"
STRIP_FROM_INC_PATH    = "@DOXYGEN_STRIP_FROM_INC_PATH@"

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = NO
TAB_SIZE               = 4

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 4
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = NO

# Extract the whole public surface: the legacy libraries carry file headers but
# not member documentation, and an API page listing every class beats a page
# listing only the annotated ones. Members picked up this way appear without a
# description, which is exactly the signal to go and write one.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHOW_HEADERFILE        = YES
SHOW_INCLUDE_FILES     = YES
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES
STRICT_PROTO_MATCHING  = NO

GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST= YES
MAX_INITIALIZER_LINES  = 30
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = @DOXYGEN_WARN_AS_ERROR@
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = "@DOXYGEN_WARN_LOGFILE@"

# Parsing and generating single threaded. Some Doxygen builds abort at the end
# of a single threaded run with a std::system_error from the worker pool, and a
# documentation build is far too fast to be worth the risk.
NUM_PROC_THREADS       = 1

INPUT                  = @DOXYGEN_INPUT@
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
EXCLUDE_SYMLINKS       = NO
EXCLUDE_PATTERNS       = @DOXYGEN_EXCLUDE_PATTERNS@

IMAGE_PATH             = "@DOXYGEN_IMAGE_PATH@"
INPUT_FILTER           =
FILTER_PATTERNS        =
USE_MDFILE_AS_MAINPAGE = "@DOXYGEN_MAINPAGE@"

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
REFERENCES_LINK_SOURCE = YES
SOURCE_TOOLTIPS        = YES
VERBATIM_HEADERS       = YES

ALPHABETICAL_INDEX     = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_EXTRA_STYLESHEET  = "@DOXYGEN_EXTRA_STYLESHEET@"
HTML_COLORSTYLE        = TOGGLE
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = NO
HTML_INDEX_NUM_ENTRIES = 100
GENERATE_DOCSET        = NO
GENERATE_HTMLHELP      = NO
GENERATE_QHP           = NO
GENERATE_ECLIPSEHELP   = NO
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
ENUM_VALUES_PER_LINE   = 4
TREEVIEW_WIDTH         = 250
EXT_LINKS_IN_WINDOW    = NO
FORMULA_FONTSIZE       = 10
USE_MATHJAX            = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
EXTERNAL_SEARCH        = NO

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
GENERATE_AUTOGEN_DEF   = NO
GENERATE_PERLMOD       = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
# Expand the macros the sources define as well, not only the ones listed below.
# The per-library namespace macros (QX_CORE_BEGIN_NAMESPACE and friends) would
# otherwise stay unexpanded and every class would end up in the global namespace,
# with the legacy and the new RibbonBar colliding; QX_*_PREPEND_NAMESPACE would
# be shown literally in signatures. Reading the real definitions keeps the
# documentation in step with *_global.h instead of duplicating the namespaces
# here.
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
# Resolving the project's own includes is what makes the macros defined in
# *_global.h visible: without it QX_DOCK_PREPEND_NAMESPACE(...) in a return type
# is not expanded, the declaration does not parse and the matching definition in
# the .cpp ends up documented without a home. Qt's own headers are not on this
# path and are therefore left alone.
INCLUDE_PATH           = "@DOXYGEN_INCLUDE_PATH@"
INCLUDE_FILE_PATTERNS  =

# Qt and project decorations that Doxygen cannot otherwise parse. The keyword
# macros expand to the very keyword they stand for so that the access specifier
# that follows (the ':' after Q_SIGNALS) is preserved, and the export macros
# vanish so that the signatures stay readable.
PREDEFINED             = \
                         "QT_BEGIN_NAMESPACE=" \
                         "QT_END_NAMESPACE=" \
                         "QT_USE_NAMESPACE=" \
                         "Q_OBJECT=" \
                         "Q_GADGET=" \
                         "Q_SIGNALS=public" \
                         "Q_SIGNAL=" \
                         "Q_SLOTS=public" \
                         "Q_SLOT=" \
                         "Q_INVOKABLE=" \
                         "Q_REQUIRED_RESULT=" \
                         "Q_NORETURN=" \
                         "Q_DECL_OVERRIDE=override" \
                         "Q_DECL_FINAL=final" \
                         "Q_DECL_EXPORT=" \
                         "Q_DECL_IMPORT=" \
                         "Q_PROPERTY(x)=" \
                         "Q_DECLARE_PRIVATE(x)=" \
                         "Q_DECLARE_PUBLIC(x)=" \
                         "Q_DECLARE_METATYPE(x)=" \
                         "Q_DECLARE_INTERFACE(x,y)=" \
                         "Q_DECLARE_OPERATORS_FOR_FLAGS(x)=" \
                         "Q_DISABLE_COPY(x)=" \
                         "Q_ENUM(x)=" \
                         "Q_ENUMS(x)=" \
                         "Q_FLAG(x)=" \
                         "Q_FLAGS(x)=" \
                         "QX_CORE_EXPORT=" \
                         "QX_THEME_EXPORT=" \
                         "QX_APP_EXPORT=" \
                         "QX_RIBBON_EXPORT=" \
                         "QX_DOCK_EXPORT=" \
                         "QX_WINDOW_EXPORT="

EXPAND_AS_DEFINED      =
SKIP_FUNCTION_MACROS   = YES

TAGFILES               =
GENERATE_TAGFILE       =

HAVE_DOT               = @DOXYGEN_HAVE_DOT@
DOT_NUM_THREADS        = 0
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = YES
UML_LOOK               = NO
UML_LIMIT_NUM_FIELDS   = 10
TEMPLATE_RELATIONS     = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = png
INTERACTIVE_SVG        = NO
DOT_GRAPH_MAX_NODES    = 60
MAX_DOT_GRAPH_DEPTH    = 0
DOT_CLEANUP            = YES
