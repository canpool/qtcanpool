<RCC>
    <qresource prefix="/icon">
        <!-- Tabler Icons 3.49.0 (MIT), the same set the ribbon demo ships.
             Monochrome stroke glyphs: each is painted in the pane's own ink
             when it is asked for (see icons.h), so one file serves both a
             light page and a dark one, and a folded pane - which is nothing
             but its icons - reads the same way in either. -->
        <file>res/icons/adjustments.svg</file>
        <file>res/icons/alert-triangle.svg</file>
        <file>res/icons/app-window.svg</file>
        <file>res/icons/arrows-split-2.svg</file>
        <file>res/icons/arrows-up-down.svg</file>
        <file>res/icons/bell.svg</file>
        <file>res/icons/bulb.svg</file>
        <file>res/icons/chevrons-down.svg</file>
        <file>res/icons/gauge.svg</file>
        <file>res/icons/grid-dots.svg</file>
        <file>res/icons/home.svg</file>
        <file>res/icons/info-circle.svg</file>
        <file>res/icons/layout-cards.svg</file>
        <file>res/icons/progress.svg</file>
        <file>res/icons/route.svg</file>
        <file>res/icons/settings.svg</file>
        <file>res/icons/sparkles.svg</file>
        <file>res/icons/square-chevron-down.svg</file>
        <file>res/icons/star.svg</file>
        <file>res/icons/tabs.svg</file>
        <file>res/icons/toggle-left.svg</file>
    </qresource>
</RCC>
